{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/send-weekly-digest",
      "schedule": "0 13 * * 2"
    },
    {
      "path": "/api/cron/send-rate-alerts",
      "schedule": "0 18 * * 4"
    },
    {
      "path": "/api/cron/send-rent-alerts",
      "schedule": "0 17 1 * *"
    },
    {
      "path": "/api/cron/send-lifecycle-emails",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/send-weekly-summary",
      "schedule": "0 15 * * 5"
    },
    {
      "path": "/api/cron/reconcile-stripe",
      "schedule": "0 16 * * 0"
    }
  ]
}
