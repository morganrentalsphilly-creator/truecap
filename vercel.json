{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/send-weekly-digest",
      "schedule": "0 13 * * 2"
    },
    {
      "path": "/api/cron/send-rate-alerts",
      "schedule": "0 18 * * 4"
    }
  ]
}
