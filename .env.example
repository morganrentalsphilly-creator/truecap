# Site URL for Supabase email links (confirm signup, password reset). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server only except publishable key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Optional: apply a Stripe coupon to annual checkout if your annual Stripe Price is not already discounted.
STRIPE_ANNUAL_DISCOUNT_COUPON_ID=

# ScrapingBee — powers the "Import from listing URL" feature.
# Sign up at https://www.scrapingbee.com and paste the API key here.
SCRAPINGBEE_API_KEY=
