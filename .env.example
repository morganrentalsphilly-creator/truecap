# Site URL for Supabase email links (confirm signup, password reset). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server only except publishable key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Checkout sells the FIRST price id. You may append comma-separated legacy /
# grandfathered price ids (e.g. an old $20/mo price after moving to $29.99/mo)
# — those still map to Pro on webhook renewal but are never sold to new users.
#   STRIPE_PRICE_PRO_MONTHLY=price_current,price_old_grandfathered
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Optional: apply a Stripe coupon to annual checkout if your annual Stripe Price is not already discounted.
STRIPE_ANNUAL_DISCOUNT_COUPON_ID=

# Google Places API key — powers the address autocomplete on the property form.
# Public (browser-exposed) — restrict the key to your domains in Google Cloud
# Console (Credentials -> Application restrictions -> HTTP referrers).
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# FRED API key — pulls the current 30-year mortgage rate so we can pre-fill
# the financing field. Free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# HUD User API token — pulls Fair Market Rent estimates by county to pre-fill
# the Monthly Rent field on single-family analyses. Free signup:
# https://www.huduser.gov/hudapi/public/register
HUD_API_KEY=

# RentCast API key — powers on-demand sale + rent comps + value/rent AVM on
# saved deals (Pro feature). Optional: the comps card stays hidden until this
# is set. Foundation plan ($74/mo, 1,000 req/mo) includes comps. Results are
# cached 30 days (property_enrichment_cache) to conserve quota.
# Sign up: https://www.rentcast.io/api
RENTCAST_API_KEY=

# Hard monthly cap on live RentCast enrichments (each ≈ 2 API calls). Guards
# the plan's request limit even across many paid users — at the cap, comps
# serve from cache or report "limit reached" instead of spending. Default 300
# (~600 calls/mo, under the 1,000 Foundation limit). Raise if you upgrade.
RENTCAST_MONTHLY_ENRICHMENT_CAP=300

# Per-Pro-user monthly cap on live comp lookups (distinct properties). Each
# property ≈ 2 API calls. Default 50 properties/user/month. Free users instead
# get a single lifetime lookup. Raise/lower to taste.
RENTCAST_PER_USER_MONTHLY_CAP=50

# Resend — newsletter delivery. Required for the schedule-broadcasts script
# and the newsletter signup form. The API key MUST have "Full Access"
# (not "Sending only") to use the Broadcasts API.
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Optional — defaults to "TrueCap <hello@usetruecap.com>" if not set.
EMAIL_FROM=
# Optional — where replies land. Defaults to hello@usetruecap.com.
EMAIL_REPLY_TO=
# REQUIRED whenever any Vercel cron is enabled. Every cron in vercel.json
# (reconcile-stripe, weekly-summary, lifecycle-emails, rate-alerts,
# rent-alerts, weekly-digest) authenticates on `Authorization: Bearer
# ${CRON_SECRET}` and returns 500 if it is unset — leaving it blank
# silently breaks those crons.
CRON_SECRET=
# Optional kill switch for the weekly newsletter cron. Set to "1" (or
# "true" / "yes") in Vercel env vars to pause weekly sends without a
# redeploy. Unset to resume. Does NOT cancel broadcasts already
# pre-scheduled at Resend — cancel those in the Resend dashboard.
NEWSLETTER_PAUSED=

# PostHog product analytics — used to build a real conversion funnel
# (landing → analyzer → analysis → checkout → subscribed). All three
# vars are optional — if NEXT_PUBLIC_POSTHOG_KEY is unset, the client
# wrapper safely no-ops and nothing tracks. Set them once you have a
# PostHog account to start collecting data.
#
# Get the public key: posthog.com → Settings → Project Settings →
# Project API Key (starts with `phc_…`).
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com if unset (PostHog Cloud US).
# Set to https://eu.i.posthog.com for the EU region.
NEXT_PUBLIC_POSTHOG_HOST=
# Get the server key: posthog.com → Settings → Personal API Keys →
# Create new (starts with `phx_…`). Used ONLY by the Stripe webhook
# to fire `pro_subscribed` server-side. Without it, that one event
# won't track but the rest of the funnel still works.
POSTHOG_API_KEY=

# Deal Q&A (AI panel) — optional. Feature hides entirely when unset.
# Anthropic API key from https://console.anthropic.com → API keys.
# Costs ~fractions of a cent per question on the default Haiku model.
ANTHROPIC_API_KEY=
# Optional model override for Deal Q&A (default: claude-haiku-4-5-20251001)
DEAL_QA_MODEL=

# Rate-drop alerts (Thursday cron, app/api/cron/send-rate-alerts).
# off (default) = feature dormant · dry = compute + JSON preview, send
# nothing · live = send via Resend. Flip off → dry → live after
# reviewing a dry run.
RATE_ALERTS_MODE=off

# Rent-change alerts (monthly cron, app/api/cron/send-rent-alerts).
# Re-prices saved single-family deals against current market rent (RentCast)
# and emails state changes. off (default) = dormant · dry = audience + cost
# SCALE preview with NO RentCast calls (zero cost) · live = fetch (capped) +
# send. Each re-priced deal spends one RentCast call against the shared
# RENTCAST_MONTHLY_ENRICHMENT_CAP budget; RENT_ALERTS_MAX_LOOKUPS_PER_RUN caps
# a single run. Set RENT_ALERTS_DRY_FETCH=1 for a real (paid) dry preview.
RENT_ALERTS_MODE=off
RENT_ALERTS_MAX_LOOKUPS_PER_RUN=100
RENT_ALERTS_DRY_FETCH=

# Lifecycle emails (daily cron, app/api/cron/send-lifecycle-emails):
# welcome, onboarding drip, free->Pro nudge, win-back.
# off (default) = dormant · dry = compute + JSON preview, send nothing ·
# live = send via Resend. Requires the lifecycle_email_log migration.
LIFECYCLE_EMAILS_MODE=off
