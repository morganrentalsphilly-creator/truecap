# Site URL for Supabase email links (confirm signup, password reset). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC key for public-share attribution, saved-report attestation,
# and the exact-deal no-signup decision grant. Use at least 32 random bytes.
# Missing configuration fails closed for the anonymous Offer Ceiling/report.
SHARE_LINK_SECRET=

# Stripe (server only except publishable key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Checkout sells the FIRST price id. You may append comma-separated legacy /
# grandfathered price ids (e.g. an old $20/mo price after moving to $24/mo)
# — those still map to Pro on webhook renewal but are never sold to new users.
#   STRIPE_PRICE_PRO_MONTHLY=price_current,price_old_grandfathered
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Agent Pro remains hidden until the monthly Price is configured. Keep the
# current Price first; append any legacy ids only for webhook recognition.
STRIPE_PRICE_AGENT_PRO_MONTHLY=
STRIPE_PRICE_AGENT_PRO_ANNUAL=
# (No TRUECAP_AGENT_PRO_RELEASED flag. Agent Pro is a live, selling tier and is
# gated on STRIPE_PRICE_AGENT_PRO_MONTHLY alone. A second env gate would delist
# a product that is already taking money the moment a deployment forgot to set
# it. To take Agent Pro off sale, unset the Price id above.)
# Historical TrueCap Deal Decision Pack Price mappings. New Pack checkout is
# disabled; retain these only so existing paid claims and Stripe records remain
# recognizable. Do not create or activate an experimental Price while the Pack
# shutdown is in effect.
STRIPE_PRICE_PDF_ONE_TIME=
STRIPE_PRICE_SINGLE_DEAL_9=
STRIPE_PRICE_SINGLE_DEAL_15=
STRIPE_PRICE_SINGLE_DEAL_19=
NEXT_PUBLIC_SINGLE_DEAL_PRICE_VARIANT=current
# Optional: apply a Stripe coupon to annual checkout if your annual Stripe Price is not already discounted.
STRIPE_ANNUAL_DISCOUNT_COUPON_ID=

# Launch Pack-to-Pro credit. Must be an exact $9-off, USD, duration-once
# Stripe coupon. Keep unset while Pack sales are disabled; historical Pack
# claims retain report recovery but do not consume a mismatched coupon.
STRIPE_PACK_CREDIT_900_COUPON_ID=

# Offer-positioning experiments (build-time, non-secret).
# Headline variants: a | b | never_overpay (default).
NEXT_PUBLIC_TRUECAP_HOMEPAGE_HEADLINE=never_overpay
NEXT_PUBLIC_TRUECAP_PRO_NAME=pro
# The Never Overpay Guarantee is ON by default (founder-approved 2026-08-17)
# with terms at the in-repo /guarantee page. Set =1 to turn every guarantee
# surface off in one deploy.
NEXT_PUBLIC_TRUECAP_GUARANTEE_DISABLED=

# Underwriting-result release flags (build-time, non-secret). Input confidence
# and the readiness ladder are released and default on; these values are
# explicit kill switches. Other unfinished workflows remain fail-closed.
NEXT_PUBLIC_TRUECAP_INPUT_CONFIDENCE=true
NEXT_PUBLIC_TRUECAP_OFFER_READY_STATUS=true
NEXT_PUBLIC_TRUECAP_WHAT_NEEDS_TO_BE_TRUE_V2=false
NEXT_PUBLIC_TRUECAP_FINANCING_PROFILES=false
NEXT_PUBLIC_TRUECAP_DEAL_DECISION_PACK=false
NEXT_PUBLIC_TRUECAP_THREE_DEAL_GUARANTEE=false
# Independent server-side creation gate. Keep false while one-time Pack sales
# are paused. New checkouts require BOTH this and the public flag above to be
# explicitly true; existing paid-claim recovery remains available.
TRUECAP_DECISION_PACK_CHECKOUT_ENABLED=false
NEXT_PUBLIC_TRUECAP_SAVED_DEAL_WATCH=false
NEXT_PUBLIC_TRUECAP_BATCH_UNDERWRITING=false
NEXT_PUBLIC_TRUECAP_AGENT_CLIENT_MATCHING=false
NEXT_PUBLIC_TRUECAP_NEW_HOMEPAGE_POSITIONING=true
# Shipped information hierarchy; these are build-time kill switches and a
# change requires rebuild/redeploy.
NEXT_PUBLIC_TRUECAP_DECISION_FIRST_RESULTS=true
NEXT_PUBLIC_TRUECAP_FOCUSED_DASHBOARD=true
# Specialist finance models stay dark until their full acquisition/rehab/
# financing/exit ledgers and cross-surface golden tests are approved.
NEXT_PUBLIC_TRUECAP_BRRRR_STRATEGY_MODEL=false
NEXT_PUBLIC_TRUECAP_FIX_FLIP_STRATEGY_MODEL=false
NEXT_PUBLIC_TRUECAP_OWNED_PORTFOLIO_ACTUALS=false
# Underwriting-safety contract: both gates must pass. Keep the public build-time
# flag false and the private server-only allowlist empty until an approved
# internal cohort is ready. The allowlist accepts comma-separated exact email
# addresses; never expose or forward it to browser code. Anonymous users remain
# ineligible even when the public flag is enabled.
NEXT_PUBLIC_TRUECAP_ADVOCACY_DECISION_CONTRACT=false
TRUECAP_ADVOCACY_INTERNAL_EMAILS=
NEXT_PUBLIC_TRUECAP_GUARANTEE_TERMS_URL=

# Google Places API key — powers the address autocomplete on the property form.
# Public (browser-exposed) — restrict the key to your domains in Google Cloud
# Console (Credentials -> Application restrictions -> HTTP referrers).
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# FRED API key — pulls the current 30-year mortgage rate so we can pre-fill
# the financing field. Free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# HUD User API token — pulls Fair Market Rent estimates by county to pre-fill
# the Monthly Rent field on single-family analyses. Free signup:
# https://www.huduser.gov/hudapi/public/register
HUD_API_KEY=

# RentCast API key — powers on-demand sale + rent comps + value/rent AVM on
# saved deals (Pro feature). Optional: the comps card stays hidden until this
# is set. Foundation plan ($74/mo, 1,000 req/mo) includes comps. Results are
# cached 30 days (property_enrichment_cache) to conserve quota.
# Sign up: https://www.rentcast.io/api
RENTCAST_API_KEY=

# Hard monthly cap on live RentCast enrichments (each ≈ 2 API calls). Guards
# the plan's request limit even across many paid users — at the cap, comps
# serve from cache or report "limit reached" instead of spending. Default 300
# (~600 calls/mo, under the 1,000 Foundation limit). Raise if you upgrade.
RENTCAST_MONTHLY_ENRICHMENT_CAP=300

# Per-Pro-user monthly cap on live comp lookups (distinct properties). Each
# property ≈ 2 API calls. Default 50 properties/user/month. Free users instead
# get a single lifetime lookup. Raise/lower to taste.
RENTCAST_PER_USER_MONTHLY_CAP=50

# How many "no data found" lookups per user per month still hand a free user's
# one lifetime freebie back. The refund exists so an un-indexed address doesn't
# burn someone's one shot — but unbounded it IS the exploit: junk address →
# miss → refund → repeat, each iteration a real RentCast call. Default 3.
RENTCAST_MISS_REFUND_CAP=3

# Resend — newsletter delivery. Required for the schedule-broadcasts script
# and the newsletter signup form. The API key MUST have "Full Access"
# (not "Sending only") to use the Broadcasts API.
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Optional — defaults to "TrueCap <hello@usetruecap.com>" if not set.
EMAIL_FROM=
# Optional — where replies land. Defaults to hello@usetruecap.com.
EMAIL_REPLY_TO=
# REQUIRED whenever any Vercel cron is enabled. Every cron in vercel.json
# (reconcile-stripe, weekly-summary, lifecycle-emails, rate-alerts,
# rent-alerts, weekly-digest) authenticates on `Authorization: Bearer
# ${CRON_SECRET}` and returns 500 if it is unset — leaving it blank
# silently breaks those crons.
CRON_SECRET=
# Optional kill switch for the weekly newsletter cron. Set to "1" (or
# "true" / "yes") in Vercel env vars to pause weekly sends without a
# redeploy. Unset to resume. Does NOT cancel broadcasts already
# pre-scheduled at Resend — cancel those in the Resend dashboard.
NEWSLETTER_PAUSED=

# PostHog product analytics — used to build a real conversion funnel
# (landing → analyzer → analysis → checkout → subscribed). All three
# vars are optional — if NEXT_PUBLIC_POSTHOG_KEY is unset, the client
# wrapper safely no-ops and nothing tracks. Set them once you have a
# PostHog account to start collecting data.
#
# Get the public key: posthog.com → Settings → Project Settings →
# Project API Key (starts with `phc_…`).
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com if unset (PostHog Cloud US).
# Set to https://eu.i.posthog.com for the EU region.
NEXT_PUBLIC_POSTHOG_HOST=
# Server-side capture uses the PostHog project API key (starts with `phc_…`),
# typically the same value as NEXT_PUBLIC_POSTHOG_KEY. It fires subscription,
# trial, and checkout events from trusted server paths. A personal `phx_…`
# key is for the Query API and will not work here.
POSTHOG_API_KEY=

# SEO control plane (server/workflow only). Safe production defaults keep the
# engine measuring without permitting autonomous public mutations. GitHub
# Actions maps its SEO_SUPABASE_* secrets into SUPABASE_* for the scripts.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE=sc-domain:usetruecap.com
PAGESPEED_API_KEY=
SEO_BASE_URL=https://usetruecap.com
SEO_GSC_BACKFILL_DAYS=7
SEO_AUTOPILOT_ENABLED=false
SEO_AUTOPUBLISH_ENABLED=false
SEO_AUTOPILOT_MODE=observe
SEO_DAILY_MUTATION_CAP=3
SEO_WEEKLY_PUBLICATION_CAP=1
SEO_DAILY_LLM_USD_CAP=5
SEO_HALT_ON_SOURCE_FAILURE=true
SEO_HALT_ON_QUALITY_FAILURE=true

# Deal Q&A (AI panel) — optional. Feature hides entirely when unset.
# Anthropic API key from https://console.anthropic.com → API keys.
# Costs ~fractions of a cent per question on the default Haiku model.
ANTHROPIC_API_KEY=
# Optional model override for Deal Q&A (default: claude-haiku-4-5-20251001)
DEAL_QA_MODEL=

# GLOBAL daily ceiling on Anthropic-billed calls across Deal Q&A + AI deal
# summary (lib/ai-spend-guard.ts, counted in app_counters). Both endpoints are
# anonymously reachable and their per-caller limiter is in-memory + IP-keyed —
# fine for a human, useless against a scripted caller rotating IPs. This is the
# dollar bound. Default 500/day (~$1/day on Haiku). 0 disables the ceiling.
# Fails OPEN: a DB hiccup lets the request through rather than downing the
# feature.
ANTHROPIC_DAILY_CALL_CAP=500

# Rate-drop alerts (Thursday cron, app/api/cron/send-rate-alerts).
# off (default) = feature dormant · dry = compute + JSON preview, send
# nothing · live = send via Resend. Flip off → dry → live after
# reviewing a dry run.
RATE_ALERTS_MODE=off

# Rent-change alerts (monthly cron, app/api/cron/send-rent-alerts).
# Re-prices saved single-family deals against current market rent (RentCast)
# and emails state changes. off (default) = dormant · dry = audience + cost
# SCALE preview with NO RentCast calls (zero cost) · live = fetch (capped) +
# send. Each re-priced deal spends one RentCast call against the shared
# RENTCAST_MONTHLY_ENRICHMENT_CAP budget; RENT_ALERTS_MAX_LOOKUPS_PER_RUN caps
# a single run. Set RENT_ALERTS_DRY_FETCH=1 for a real (paid) dry preview.
RENT_ALERTS_MODE=off
RENT_ALERTS_MAX_LOOKUPS_PER_RUN=100
RENT_ALERTS_DRY_FETCH=

# Lifecycle emails (daily cron, app/api/cron/send-lifecycle-emails):
# welcome, onboarding drip, free->Pro nudge, win-back.
# off (default) = dormant · dry = compute + JSON preview, send nothing ·
# live = send via Resend. Requires the lifecycle_email_log migration.
LIFECYCLE_EMAILS_MODE=off
