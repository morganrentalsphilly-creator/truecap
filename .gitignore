/.preview

# misc
.DS_Store
*.pem
# FUSE mount artifacts — transient hidden copies the synced workspace creates
# while a file has an open handle. Never source; safe to ignore (and delete).
.fuse_hidden*

# debug — `*.log` is fine. `*.md` and `*.ps1` removed: blocking every
# markdown file silently hides README/CLAUDE/changelog edits from git.
# Tracked docs (docs/*.md, CLAUDE.md, README) are unaffected since
# they're already in the index, but NEW markdown files were getting
# dropped without warning. Restored to log-only.
*.log
# local env files
.env.development.local
.env.test.local
.env.production.local

