# dependencies
/node_modules

# next.js build output
/.next
/out
/.tmp-supabase-push

# production
/build

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables — ignore every .env file by default, then
# explicitly un-ignore the example template so the repo ships with a
# documented env shape but never with real secrets.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# next/image cache
.next/cache

# local-only campaign preview artifact (regenerated by `npm run preview-daily-campaign`)
/.preview

# misc
.DS_Store
*.pem

# debug — `*.log` is fine. `*.md` and `*.ps1` removed: blocking every
# markdown file silently hides README/CLAUDE/changelog edits from git.
# Tracked docs (docs/*.md, CLAUDE.md, README) are unaffected since
# they're already in the index, but NEW markdown files were getting
# dropped without warning. Restored to log-only.
*.log
# local env files
.env.development.local
.env.test.local
.env.production.local

# IDEs
.vscode
.idea

# Cursor / AI local metadata
.cursor/
/supabase/.temp
agent-transcripts/
terminals/
mcps/
/.cursor
# Editor + tooling metadata (PostHog wizard, Claude session artifacts).
# Not source — local-only tooling state. Treat like .vscode / .idea.
.claude/
/.pdf_review
# `/scripts` removed: that directory holds tracked utility scripts
# (schedule-all-broadcasts, schedule-daily-campaign, preview-daily-campaign,
# count-audience-contacts, polish-emails). Ignoring the whole directory
# silently blocked new scripts from being added to the deploy. If a
# specific script in there needs to stay local, ignore it by exact
# filename instead of the parent folder.


# lock files (optional - depends on your team)
/package-lock.json
/yarn.lock
/pnpm-lock.yaml
# Sentry Config File
.env.sentry-build-plugin
config.bat
